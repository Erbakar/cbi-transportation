APP_USERNAME=
APP_PASSWORD_HASH=
ENCRYPTION_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
PLATFORM_CONTRACTS=[]

# Vite dotenv expands dollar signs: escape literal placeholders in local env values
# as \$credential:username, \$credential:password and \$field:bookingNumber.
# Do not add these escapes to JSON passed directly to Worker secrets.

# Optional local-only CMA browser bridge. Configure with scripts/cma-bridge/setup.mjs.
# Never publish the shared key. This bridge is not reachable from a deployed Worker.
CMA_BROWSER_KEY=
CMA_BROWSER_OWNER=
